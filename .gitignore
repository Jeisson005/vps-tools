# Environment / secrets / local overrides
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
**/*.local.*
**/banner.txt
**/custom_banner.txt

# Logs
**/logs/*
!**/logs/.gitkeep
**/*.log

# Security monthly reports (generated artifacts, may list versions)
**/security/reports/*
!**/security/reports/.gitkeep

# Security local overrides (operator-specific, never commit)
security/baseline/local/

# RustDesk runtime data and keys
**/rustdesk/data/
**/rustdesk/web-config/
**/id_ed25519*
**/*.sqlite3*

# Headscale runtime data and keys
**/headscale/data/
**/headscale/config/config.yaml
**/headscale-node/state/
**/*.sqlite*
**/*_private.key
# Headscale UI live API key (rendered at deploy, never commit)
/headscale/web/config.js
**/headscale/web/config.js

# Filebrowser runtime data (user files, db, settings)
**/filebrowser/data/

# Open WebUI runtime (webui.db, uploads, vector_db, HF embedding cache ~1GB)
**/open-webui/data/

# Sentinel runtime (nested git repos per task, isolated crontab, venv, logs)
sentinel/tasks/
sentinel/cron/sentinel.tab
sentinel/venv/
sentinel/logs/

# Hermes runtime memories (local-only, may contain personal data, never commit)
hermes/memories/

# Backups / dumps
**/backups/
**/*.sql
**/*.dump
**/*.bak
**/*.bak*
**/.bak*/
**/*~
**/*.orig
**/*.rej
!**/scripts/*.sql

# Python
**/__pycache__/
**/*.py[cod]
**/venv/
**/.venv/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/

# Node
**/node_modules/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Temporary scratch files
tmp/
/tmp/