# Environment / secrets / local overrides
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
**/*.local.*
**/banner.txt
**/custom_banner.txt

# Logs
**/logs/*
!**/logs/.gitkeep
**/*.log

# RustDesk runtime data and keys
**/rustdesk/data/
**/rustdesk/web-config/
**/id_ed25519*
**/*.sqlite3*

# Backups / dumps
**/backups/
**/*.sql
**/*.dump
**/*.bak
!**/scripts/*.sql

# Python
**/__pycache__/
**/*.py[cod]

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Zitadel PATs
**/*.pat
**/*.pat.expiry

tmp