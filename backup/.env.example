# ==============================================================================
# VPS Backup & Google Drive Configuration
# ==============================================================================

# Rclone remote name and target folder in Google Drive
# Syntax: <remote_name>:<drive_folder>
RCLONE_REMOTE=gdrive:vps-tools-backups

# Secret Master Encryption Key for GPG AES-256 (symmetric)
# Protects your .env files, tokens, databases, and configs
BACKUP_ENCRYPTION_KEY="ChangeThisMasterKey_UseAStrongPasswordOrLeaveGenerated"

# Retention Policy (Grandfather-Father-Son)
# RETENTION_DAYS: Maximum number of daily backups to keep in Google Drive
RETENTION_DAYS=7

# RETENTION_MONTHS: Maximum number of monthly backups to keep in Google Drive
RETENTION_MONTHS=12

# Source directory to backup (defaults to the entire home directory of the current user)
# SOURCE_DIR=/home/username
SOURCE_DIR="${HOME}"

# Temporary directory for staging and compression (deleted after upload)
TEMP_DIR=/tmp/vps-backups

# Telegram Bot Notifications (Optional - alerts on failure or success)
# TELEGRAM_BOT_TOKEN="123456789:ABCdef..."
# TELEGRAM_CHAT_ID="12345678"
# NOTIFY_ON_SUCCESS=false # Set to true if you also want a message when backup succeeds
