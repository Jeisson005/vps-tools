# GNU Tar Exclude List for VPS Backups
# Directories and patterns excluded anywhere in the tree

# Dependencies and package managers
node_modules
.npm
.pnpm-store
.yarn/cache

# Python virtualenvs, bytecode and caches
venv
.venv
.venv-*
__pycache__
*.pyc
*.pyo
*.pyd
.pytest_cache

# Rust / Go build caches
target/debug
target/release
.cargo/registry
.cargo/git
go/pkg

# Version control internals (code is in remote repos)
.git

# Heavy system and user caches
.cache
.gvfs
.dbus
.pulse
.XDG
.local/share/Trash
Cache
cached-data

# Browser internal cache and root container data
*Cache*
*cache*
google-chrome/*Cache*
chromium/*Cache*
steel-chrome
*/steel-chrome/*
*/steel/data/*
*/rustdesk/web-config/*
*/rustdesk/web-config

# Staging, temp, locks, and sockets
tmp
vps-backups
*.sock
*.lock
.ssh/agent
.ssh/agent/*
*/.XDG/*
*/.dbus/*
*/.pulse/*
*/pulse/*

# Rotated and oversized logs
*.log.1
*.log.gz
*.log.20*
