# ==============================================================================
# BASH-MCP HOST SERVICE CONFIGURATION
# ==============================================================================

# HTTP Listening Port and Host (Loopback 127.0.0.1 recommended for security)
MCP_PORT=8001
MCP_BIND=127.0.0.1

# Execution Mode:
# 'readOnly' = Blocks commands that write to filesystem or make destructive changes
# 'off'      = Full unrestricted execution of bash commands on the host server
BASH_MCP_MODE=off

# Systemd Service user to run the process (e.g. root, deploy, jeisson)
SERVICE_USER=root

# Systemd service name
SERVICE_NAME=bash-mcp-http
