# ==============================================================================
# BASH-MCP HOST SERVICE CONFIGURATION
# ==============================================================================

# HTTP Listening Port and Host (Loopback 127.0.0.1 recommended for security)
MCP_PORT=8001
MCP_BIND=127.0.0.1

# Execution Mode:
# 'readOnly' = Blocks commands that write to filesystem or make destructive changes
# 'off'      = Full unrestricted execution of bash commands on the host server
BASH_MCP_MODE=off

# Systemd Service user to run the process (e.g. root, deploy, jeisson)
SERVICE_USER=root

# Systemd service name
SERVICE_NAME=bash-mcp-http

# ------------------------------------------------------------------------------
# UNIVERSAL SCHEMA SANITIZING & COMPATIBILITY PROXY
# ------------------------------------------------------------------------------
# Sanitizes tools/list schemas into the subset accepted by all LLM providers
# (Google Gemini, OpenAI, Claude, Cursor, Ollama, DeepSeek, etc.).
# Bind 0.0.0.0 so the Nginx container can reach it via host.docker.internal;
# the port is firewalled to the Docker bridge only (172.16.0.0/12).
SCHEMA_PROXY_PORT=8002
SCHEMA_PROXY_BIND=0.0.0.0

# Drop outputSchema from tools/list (cuts payload ~35% and saves context tokens)
SCHEMA_PROXY_STRIP_OUTPUT=1

# Systemd service name for the proxy
SCHEMA_PROXY_SERVICE_NAME=bash-mcp-schema-proxy

# Idle MCP session lifetime in ms (stateful mode). Sessions are reused, so one
# child process serves many requests instead of one leaking per request.
MCP_SESSION_TIMEOUT=1800000
