# ==============================================================================
# VPS Tools Centinela - Monitoring & Alerting Configuration
# ==============================================================================

# Telegram Bot Notifications (Optional)
# Obtain token from @BotFather and chat ID from @userinfobot
# TELEGRAM_BOT_TOKEN="123456789:ABCdef..."
# TELEGRAM_CHAT_ID="12345678"

# Disk Space Alert Threshold (in percentage, default: 85%)
# Sends an urgent alert when any monitored mount point exceeds this percentage.
DISK_ALERT_THRESHOLD=85

# Mount points to monitor (space-separated, default: /)
MONITORED_MOUNTS="/"

# Send notification even if disk usage is healthy (default: false)
NOTIFY_ON_HEALTHY=false
