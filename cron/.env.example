# Cron - optional local overrides
# Copy to .env (gitignored) and adjust. NEVER commit the real .env.
# If a variable is not set here, scripts fall back to sentinel/.env
# for Telegram credentials, so usually you don't need this file at all.

# --- check_ram.sh / check_disk.sh ---
# Alert when RAM usage reaches this % (default: 85)
RAM_ALERT_THRESHOLD=85
# Alert when Swap usage reaches this % (default: 70)
SWAP_ALERT_THRESHOLD=70
# Alert when disk usage reaches this % (default: 85)
DISK_ALERT_THRESHOLD=85
# Mounts to monitor, space-separated (default: /)
MONITORED_MOUNTS="/"
# Minimum hours between Telegram alerts (anti-spam, default: 6)
ALERT_COOLDOWN_HOURS=6
# Send a message even when everything is healthy (default: false)
NOTIFY_ON_HEALTHY=false

# --- nightly_refresh.sh ---
# Set any of these to false to skip that step
REFRESH_OPENCODE=true
REFRESH_OPEN_WEBUI=true
REFRESH_RUSTDESK_WEB=true
DOCKER_BUILDER_PRUNE=true
CLEAN_TMP=true
# Max journal size to keep (set to 0 to skip). Requires passwordless sudo.
JOURNAL_VACUUM_SIZE=500M
# Notify on every successful nightly refresh (failures always notify)
NOTIFY_ON_REFRESH=false

# --- Telegram overrides (optional) ---
# If empty, check_ram.sh uses TELEGRAM_BOT_URGENT_TOKEN and nightly_refresh.sh
# uses TELEGRAM_BOT_ROUTINE_TOKEN from sentinel/.env + TELEGRAM_CHAT_ID.
# TELEGRAM_BOT_URGENT_TOKEN=
# TELEGRAM_BOT_ROUTINE_TOKEN=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
