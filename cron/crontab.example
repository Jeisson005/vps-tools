# ==============================================================================
# EXAMPLE 1: STANDARD MAINTENANCE
# ==============================================================================
# Adjust '/path/to/vps-tools' to the real absolute path of your project.
# Scheduled to run between 6:00 AM and 8:00 AM UTC (1:00 AM - 3:00 AM UTC-5).

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

# 1. Cron function test (Every 2 minutes)
*/2 * * * * /path/to/vps-tools/cron/cron_test.sh

# 2. Postgres Backups (Daily at 6:00 AM UTC / 1:00 AM UTC-5)
0 6 * * * /path/to/vps-tools/postgres/scripts/backup_dbs.sh >> /path/to/vps-tools/postgres/logs/backup.log 2>&1

# 3. Old Postgres Backups Cleanup (Daily at 6:30 AM UTC / 1:30 AM UTC-5)
30 6 * * * /path/to/vps-tools/postgres/scripts/cleanup_backups.sh >> /path/to/vps-tools/postgres/logs/cleanup.log 2>&1

# 4. Redis Backups (Daily at 5:00 AM UTC / 12:00 AM UTC-5)
0 5 * * * /path/to/vps-tools/redis/scripts/backup.sh >> /path/to/vps-tools/redis/logs/backup.log 2>&1

# 5. Old Redis Backups Cleanup (Daily at 5:30 AM UTC / 12:30 AM UTC-5)
30 5 * * * /path/to/vps-tools/redis/scripts/cleanup_backups.sh >> /path/to/vps-tools/redis/logs/cleanup.log 2>&1

# 6. MongoDB Backups (Daily at 4:30 AM UTC / 11:30 PM UTC-5)
30 4 * * * /path/to/vps-tools/mongodb/scripts/backup_dbs.sh >> /path/to/vps-tools/mongodb/logs/backup.log 2>&1

# 7. Old MongoDB Backups Cleanup (Daily at 4:45 AM UTC / 11:45 PM UTC-5)
45 4 * * * /path/to/vps-tools/mongodb/scripts/cleanup_backups.sh >> /path/to/vps-tools/mongodb/logs/cleanup.log 2>&1

# 8. Nginx Certificate Renewal (Daily at 7:00 AM UTC / 2:00 AM UTC-5)
0 7 * * * /path/to/vps-tools/nginx/scripts/certbot_renew.sh >> /path/to/vps-tools/nginx/logs/renew.log 2>&1

# 9. Log Cleanup (Daily at 8:00 AM UTC / 3:00 AM UTC-5)
# Keeps logs for 30 days by default.
0 8 * * * /path/to/vps-tools/cron/cleanup_logs.sh >> /path/to/vps-tools/cron/logs/cleanup.log 2>&1

# 10. Automated VPS Backup to Google Drive (Daily at 8:30 AM UTC / 3:30 AM UTC-5)
# GFS Retention: 7 daily + 12 monthly backups, GPG AES-256 encrypted
30 8 * * * /path/to/vps-tools/backup/scripts/backup.sh >> /path/to/vps-tools/cron/logs/backup.log 2>&1

# 11. Disk Space Health Check (Daily at 9:00 AM UTC / 4:00 AM UTC-5)
# Thresholds in cron/.env. Alerts via Telegram with 6h anti-spam cooldown.
0 9 * * * /path/to/vps-tools/cron/check_disk.sh >> /path/to/vps-tools/cron/logs/disk.log 2>&1

# 12. RAM & Swap Health Check (Hourly at minute 5)
# Hourly because RAM spikes in minutes (disk moves slowly, daily is enough).
# Only notifies on breach; cooldown avoids Telegram spam on sustained alerts.
5 * * * * /path/to/vps-tools/cron/check_ram.sh >> /path/to/vps-tools/cron/logs/ram.log 2>&1

# 13. Nightly Refresh (Daily at 7:30 AM UTC / 2:30 AM UTC-5)
# Restarts opencode-web, open-webui, rustdesk-web + light cleanup.
# NEVER touches steel-*, wa-*, hermes-*, sentinel, nginx, headscale.
# Flags in cron/.env (all default true). Requires passwordless sudo for systemctl.
30 7 * * * /path/to/vps-tools/cron/nightly_refresh.sh >> /path/to/vps-tools/cron/logs/refresh.log 2>&1

# 14. CPU, Steal & IOWait Health Check (Hourly at minute 15)
# Load saturation alerts via urgent bot; steal-only via routine bot.
# cpu.log doubles as evidence for provider overselling disputes.
15 * * * * /path/to/vps-tools/cron/check_cpu.sh >> /path/to/vps-tools/cron/logs/cpu.log 2>&1

# 15. Monthly Security Audit (Day 1 at 8:00 AM UTC / 3:00 AM UTC-5)
# Layer 1: programmatic scan -> security/reports/YYYY-MM/. Layer 2: opencode
# agent reviews + verdicts via Telegram (routine one-liner if all clear,
# urgent if something is exposed). The agent sends the report itself.
0 8 1 * * /path/to/vps-tools/security/scripts/monthly_audit.sh >> /path/to/vps-tools/cron/logs/security_$(date +\%Y\%m).log 2>&1


# ==============================================================================
# EXAMPLE 2: SPECIFIC CONFIGURATION (ROOT-BASED EXECUTION & DATE-BASED LOGS)
# ==============================================================================

# 1. Cron function test (Disabled by default)
# */2 * * * * /path/to/vps-tools/cron/cron_test.sh

# 2. Postgres Backups with 90-day retention (Daily at 6:00 AM UTC / 1:00 AM UTC-5)
# Executed from the postgres folder. Logs are created with current date.
0 6 * * * cd /path/to/vps-tools/postgres && export RETENTION_DAYS=90 && ./scripts/backup_dbs.sh >> logs/backup_$(date +\%Y\%m\%d).log 2>&1

# 3. Redis Backups with 30-day retention (Daily at 5:00 AM UTC / 12:00 AM UTC-5)
0 5 * * * cd /path/to/vps-tools/redis && export RETENTION_DAYS=30 && ./scripts/backup.sh >> logs/backup_$(date +\%Y\%m\%d).log 2>&1

# 4. MongoDB Backups with 30-day retention (Daily at 4:30 AM UTC / 11:30 PM UTC-5)
30 4 * * * cd /path/to/vps-tools/mongodb && export RETENTION_DAYS=30 && ./scripts/backup_dbs.sh >> logs/backup_$(date +\%Y\%m\%d).log 2>&1

# 5. Nginx Certificate Renewal (Every 15th of the month at 7:00 AM UTC / 2:00 AM UTC-5)
# Executed from the nginx folder.
0 7 15 * * cd /path/to/vps-tools/nginx && ./scripts/certbot_renew.sh >> logs/renew_$(date +\%Y\%m\%d).log 2>&1

# 6. Log Cleanup (Daily at 8:00 AM UTC / 3:00 AM UTC-5)
# Note: Cleanup is crucial when using date-based filenames to avoid disk fill-up.
0 8 * * * cd /path/to/vps-tools/cron && export LOG_RETENTION_DAYS=30 && ./cleanup_logs.sh >> logs/cleanup.log 2>&1




