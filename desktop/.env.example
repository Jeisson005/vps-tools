# ==============================================================================
# REMOTE DESKTOP & KASMVNC CONFIGURATION
# ==============================================================================

# User for the remote desktop session
DESKTOP_USER=your_desktop_user

# Password for KasmVNC web login and XRDP session (set strong password in .env)
DESKTOP_PASSWORD=ChangeThisSecurePassword123!

# KasmVNC Web Desktop Port (HTTP/WebSocket)
KASMVNC_PORT=8444
KASMVNC_BIND=0.0.0.0

# VNC Display number (e.g. :1) and default resolution
KASMVNC_DISPLAY=1
KASMVNC_RESOLUTION=1920x1080
KASMVNC_DEPTH=24

# XRDP Configuration (loopback + trusted nets only, never the public interface).
# RDP attaches to the same single :1 session via Xvnc-shared (x11vnc bridge).
XRDP_PORT=3389
XRDP_BIND=127.0.0.1
# Extra trusted bind, e.g. your Tailscale IP so phones/laptops on the tailnet
# reach RDP directly (auto-detected from `tailscale ip -4` if left empty).
XRDP_EXTRA_BIND=
