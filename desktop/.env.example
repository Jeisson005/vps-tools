# ==============================================================================
# REMOTE DESKTOP & KASMVNC CONFIGURATION
# ==============================================================================

# User for the remote desktop session
DESKTOP_USER=your_desktop_user

# Password for KasmVNC web login and XRDP session (set strong password in .env)
DESKTOP_PASSWORD=ChangeThisSecurePassword123!

# KasmVNC Web Desktop Port (HTTP/WebSocket)
KASMVNC_PORT=8444
KASMVNC_BIND=0.0.0.0

# VNC Display number (e.g. :1) and default resolution
KASMVNC_DISPLAY=1
KASMVNC_RESOLUTION=1920x1080
KASMVNC_DEPTH=24

# XRDP Configuration (Restricted to loopback/wireguard, never exposed to internet)
XRDP_PORT=3389
XRDP_BIND=127.0.0.1
