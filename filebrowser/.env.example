# ==============================================================================
# FILEBROWSER MODULE CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and adjust the variables to your needs.
# NEVER commit your real .env file with actual credentials or secrets to git.
#   cp .env.example .env && chmod 600 .env

# ── Image ─────────────────────────────────────────────────────────────────────
# Pinned s6 variant (PUID/PGID aware, healthy on Alpine).
FILEBROWSER_IMAGE=filebrowser/filebrowser:s6

# ── Network & Ports ───────────────────────────────────────────────────────────
# Local bind behind Nginx reverse proxy (loopback only, never expose publicly).
FILEBROWSER_PORT=8095

# Public domains served by Nginx (both point to the same container).
FILEBROWSER_DOMAIN=files.your-domain.com
FILEBROWSER_ALT_DOMAIN=filebrowser.your-domain.com

# ── Permissions & Timezone ────────────────────────────────────────────────────
# Run `id -u` / `id -g` on the VPS and set them here so files written
# through the web UI keep the correct host ownership.
PUID=1000
PGID=1000
TZ=America/Bogota

# ── Files Root ──────────────────────────────────────────────────────────────────
# Host folder exposed as Filebrowser root (login lands here).
# Keep the default for an isolated sandbox, or point it at real files:
#   FILEBROWSER_FILES_DIR=/home/jeisson
FILEBROWSER_FILES_DIR=./data/srv

# ── Docker Network ────────────────────────────────────────────────────────────
NGINX_NETWORK=nginx_default

# ── Resource Limits ───────────────────────────────────────────────────────────
FILEBROWSER_CPUS_LIMIT=0.50
FILEBROWSER_MEM_LIMIT=256M
FILEBROWSER_CPUS_RESERVE=0.10
FILEBROWSER_MEM_RESERVE=64M

# ── App Auth (info only, NOT read by the container) ───────────────────────────
# Filebrowser manages its own users in ./data/database.
# First start prints a random admin password once in the logs:
#   docker compose logs filebrowser 2>&1 | grep -i password
# Default user if no DB exists yet: admin / admin
# Change it immediately under Settings -> Users.
# Nginx adds a second layer (HTTP Basic Auth with the shared /etc/nginx/auth/.htpasswd).
FB_ADMIN_USER=admin
