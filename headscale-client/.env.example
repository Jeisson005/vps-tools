# ==============================================================================
# Headscale Linux Client Environment Configuration
# ==============================================================================

# Headscale Control Server URL
HEADSCALE_URL="https://headscale.jeisson.top"

# Headscale Pre-Auth Key (Master / Reusable key)
HEADSCALE_AUTH_KEY="your_headscale_preauth_key_here"

# Hostname to register for this machine
CLIENT_HOSTNAME="jeisson-laptop"

# Exit Node IP / Hostname for Full Tunneling (VPS Server)
EXIT_NODE="100.64.0.4"

# Local Web Dashboard Port (Uncommon developer port)
WEB_PORT="30701"
