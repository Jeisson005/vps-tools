# ==============================================================================
# Headscale Linux Client Environment Configuration
# ==============================================================================

# Headscale Control Server URL
HEADSCALE_URL="https://headscale.jeisson.top"

# Headscale Pre-Auth Key
# ⚠️ NUNCA pongas la llave real aquí: este archivo está en git (repo público).
#    Copia este archivo a .env (que sí está en .gitignore) y pon la llave allá.
#    El valor que aprendimos a la mala: una llave real terminó en el historial de
#    git y hubo que expirarla en el servidor (2026-10-02).
# Genera una llave de UN SOLO USO y vida corta justo antes de enrolar:
#   docker exec headscale headscale preauthkeys create -u jeisson --expiration 1h
#    (por defecto ya es 1h y NO reusable; añade --reusable solo si sabes por qué)
# Enrolar consume la llave: si el enrolamiento falla, genera otra.
HEADSCALE_AUTH_KEY="pon_aqui_una_llave_de_un_solo_uso"

# Hostname to register for this machine
CLIENT_HOSTNAME="jeisson-laptop"

# Exit Node IP / Hostname for Full Tunneling (VPS Server)
EXIT_NODE="100.64.0.4"

# Local Web Dashboard Port (Uncommon developer port)
WEB_PORT="30701"
