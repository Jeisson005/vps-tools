# ==============================================================================
# Headscale Portable Node / Subnet Router / Bridge Configuration
# ==============================================================================

# Headscale Server Control URL
HEADSCALE_SERVER_URL=https://headscale.jeisson.top

# Pre-Auth Key generated from the Headscale server (./scripts/preauthkey.sh)
TS_AUTHKEY=tskey-auth-xxxxxx

# Hostname for this node on the Tailscale mesh
NODE_HOSTNAME=home-bridge

# Container Name
CONTAINER_NAME=headscale-bridge

# Subnet Routes to advertise to the mesh (e.g. your home LAN or office LAN)
# Leave blank if this node does not route local subnets.
# Examples:
#   Home LAN:   192.168.1.0/24
#   Office LAN: 10.0.0.0/16,172.16.0.0/16
ADVERTISE_ROUTES=192.168.1.0/24

# Additional Tailscale arguments
# To make this node an EXIT NODE (allow devices to route ALL internet traffic through this node):
# TS_EXTRA_ARGS=--advertise-exit-node --accept-routes
TS_EXTRA_ARGS=--accept-routes
