# ==============================================================================
# Headscale (Self-Hosted Tailscale Control Server) Configuration
# ==============================================================================

# Server Domain & URL
HEADSCALE_DOMAIN=headscale.jeisson.top
HEADSCALE_SERVER_URL=https://headscale.jeisson.top

# Base DNS Domain for MagicDNS (e.g. vpn.jeisson.top)
HEADSCALE_BASE_DOMAIN=vpn.jeisson.top

# Default Namespace / User
HEADSCALE_DEFAULT_USER=jeisson

# IP Prefixes for the Tailscale mesh
HEADSCALE_IP_PREFIX_V4=100.64.0.0/10
HEADSCALE_IP_PREFIX_V6=fd7a:115c:a1e0::/48

# Resource Limits
HEADSCALE_CPUS_LIMIT=0.50
HEADSCALE_MEM_LIMIT=256M
HEADSCALE_CPUS_RESERVE=0.10
HEADSCALE_MEM_RESERVE=64M

HEADSCALE_UI_CPUS_LIMIT=0.25
HEADSCALE_UI_MEM_LIMIT=128M
HEADSCALE_UI_CPUS_RESERVE=0.05
HEADSCALE_UI_MEM_RESERVE=32M

# Nginx Network
NGINX_NETWORK=nginx_default
