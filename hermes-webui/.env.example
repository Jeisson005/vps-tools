# ==============================================================================
# Hermes WebUI (nesquena/hermes-webui) — community web client for Hermes Agent
# ==============================================================================

# Public port on loopback only (nginx proxies chat.* -> here)
HERMES_WEBUI_PORT=8787

# Password for the WebUI login (REQUIRED — empty = no auth, never expose that way).
# Empty on first start = auto-generated once and stored back here (chmod 600).
HERMES_WEBUI_PASSWORD=

# Display name for the assistant in the UI (default: Hermes).
HERMES_WEBUI_BOT_NAME=Hermes

# Host paths
HERMES_HOME_DIR=/home/jeisson/.hermes
HERMES_WORKSPACE_DIR=/home/jeisson/workspace

# Container file ownership (match the desktop user)
WANTED_UID=1001
WANTED_GID=1001

# Public DNS served by nginx (chat.*)
HERMES_WEBUI_DOMAIN=chat.jeisson.top

# Docker Network
NGINX_NETWORK=nginx_default
