# Hermes AI Agent & Dashboard Configuration Template
# Copy to .env and adjust variables with your own values.
# NEVER commit your real .env file with actual credentials to git.

# System user that runs the Hermes services
HERMES_USER=your_user

# System Timezone
TZ=America/Bogota

# Hermes Web Dashboard Settings
HERMES_DASHBOARD_ENABLED=true
HERMES_DASHBOARD_PORT=9119
HERMES_DASHBOARD_HOST=0.0.0.0

# Hermes Dashboard Basic Authentication
HERMES_DASHBOARD_USERNAME=your_username
HERMES_DASHBOARD_PASSWORD=your_secure_password_here

# Messaging Gateway Settings (Telegram, Discord, etc.)
HERMES_GATEWAY_ENABLED=true


# Telegram Bot Integration (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Comma-separated allowed Telegram user IDs or usernames (leave blank or set to your Telegram ID)
TELEGRAM_ALLOWED_USERS=your_telegram_username_or_id
