# Hermes AI Agent & Dashboard Configuration Template
# Copy to .env and adjust variables with your own values.
# NEVER commit your real .env file with actual credentials to git.

# System user that runs the Hermes services
HERMES_USER=your_user

# System Timezone
TZ=America/Bogota

# Hermes Web Dashboard Settings
HERMES_DASHBOARD_ENABLED=true
HERMES_DASHBOARD_PORT=9119
HERMES_DASHBOARD_HOST=0.0.0.0

# Hermes Dashboard Basic Authentication
HERMES_DASHBOARD_USERNAME=your_username
HERMES_DASHBOARD_PASSWORD=your_secure_password_here

# Messaging Gateway Settings (Telegram, Discord, etc.)
HERMES_GATEWAY_ENABLED=true
# Optional advertised model id for the gateway api_server (/v1/models).
# Empty = upstream default ("hermes-agent"). Example (server-local only):
# HERMES_MODEL_NAME=sofia


# Telegram Bot Integration (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Comma-separated allowed Telegram user IDs or usernames (locks bot strictly to you)
TELEGRAM_ALLOWED_USERS=your_telegram_id
TELEGRAM_DM_POLICY=allowlist
# Optional: Send Telegram notification when Hermes Gateway starts successfully (true/false)
HERMES_STARTUP_NOTIFICATION=true

# WhatsApp Integration (Baileys web bridge on port 3005)
WHATSAPP_ENABLED=true
# Comma-separated allowed WhatsApp user IDs / phone numbers (locks bot strictly to you)
WHATSAPP_ALLOWED_USERS=your_whatsapp_id_or_phone
WHATSAPP_DM_POLICY=allowlist
