# Hermes Agent Configuration Template
# Copy to .env and adjust variables with your own values.
# NEVER commit your real .env file with actual credentials or API keys to git.

# System user that owns and runs Hermes
HERMES_USER=your_user

# Web Dashboard Configuration (Port 9119)
HERMES_DASHBOARD_ENABLED=true
HERMES_DASHBOARD_PORT=9119
HERMES_DASHBOARD_HOST=0.0.0.0
HERMES_DASHBOARD_USERNAME=your_user
HERMES_DASHBOARD_PASSWORD=ChangeThisSecurePassword123!

# Default LLM Provider (openai, anthropic, openrouter, local, etc.)
HERMES_DEFAULT_PROVIDER=openrouter

# Optional API Keys (configure via `hermes setup` or environment)
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
