[Unit]
Description=Hermes Agent Web Dashboard (Nous Research)
After=network.target
Wants=network.target

[Service]
Type=simple
User={{HERMES_USER}}
Group={{HERMES_USER}}
ExecStart={{HERMES_HOME}}/.hermes/hermes-agent/venv/bin/python -m hermes_cli.main dashboard --port {{HERMES_PORT}} --host {{HERMES_HOST}} --no-open --skip-build
WorkingDirectory={{HERMES_HOME}}/.hermes/hermes-agent
Environment="HOME={{HERMES_HOME}}"
Environment="USER={{HERMES_USER}}"
Environment="PATH={{HERMES_HOME}}/.hermes/hermes-agent/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="VIRTUAL_ENV={{HERMES_HOME}}/.hermes/hermes-agent/venv"
Environment="HERMES_HOME={{HERMES_HOME}}/.hermes"
Environment="TZ=America/Bogota"
Restart=always
RestartSec=3
KillMode=mixed
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
