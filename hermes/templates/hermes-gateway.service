[Unit]
Description=Hermes Agent Gateway - Messaging Platform Integration
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User={{HERMES_USER}}
Group={{HERMES_USER}}
ExecStart={{HERMES_HOME}}/.hermes/hermes-agent/venv/bin/python -m hermes_cli.main gateway run
WorkingDirectory={{HERMES_HOME}}/.hermes
Environment="HOME={{HERMES_HOME}}"
Environment="USER={{HERMES_USER}}"
Environment="LOGNAME={{HERMES_USER}}"
Environment="PATH=/usr/bin:{{HERMES_HOME}}/.hermes/hermes-agent/venv/bin:{{HERMES_HOME}}/.hermes/hermes-agent/node_modules/.bin:{{HERMES_HOME}}/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="VIRTUAL_ENV={{HERMES_HOME}}/.hermes/hermes-agent/venv"
Environment="HERMES_HOME={{HERMES_HOME}}/.hermes"
Environment="API_SERVER_MODEL_NAME={{HERMES_MODEL_NAME}}"
Environment="TZ=America/Bogota"
Restart=always
RestartSec=5
RestartForceExitStatus=75
RestartPreventExitStatus=78
KillMode=mixed
KillSignal=SIGTERM
ExecReload=/bin/kill -USR1 $MAINPID
ExecStartPost=-{{HERMES_HOME}}/vps-tools/hermes/scripts/notify_ready.sh
ExecStopPost=-{{HERMES_HOME}}/.hermes/hermes-agent/venv/bin/python -m gateway.cgroup_cleanup
TimeoutStopSec=60
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
