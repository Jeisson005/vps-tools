# ==============================================================================
# MCP GATEWAY CONFIGURATION (.env)
# ==============================================================================

# Network & Host Binding
MCP_PORT=8005
MCP_DOMAIN=mcp.jeisson.top
NGINX_NETWORK=nginx_default

# Security & Authentication
# Admin Web Dashboard password (change immediately in production!)
MCP_ADMIN_PASSWORD=change_this_to_a_secure_admin_password

# API Key required by LLM clients (Open WebUI, Cursor, OpenCode, Hermes)
# Passed via "Authorization: Bearer <KEY>" or header "X-API-Key: <KEY>" or "?api_key=<KEY>"
MCP_API_KEY=mcp_sec_replace_with_a_secure_token

# Master encryption key (used to encrypt GPG keys and passwords stored in local SQLite)
# Auto-generated by scripts/install.sh if left empty
MCP_MASTER_KEY=

# ------------------------------------------------------------------------------
# Service: Passbolt (Can also be configured / uploaded directly in Admin Panel)
# ------------------------------------------------------------------------------
PASSBOLT_URL=https://passbolt.yourdomain.com
PASSBOLT_PASSPHRASE=
PASSBOLT_USER_EMAIL=bot@yourdomain.com
PASSBOLT_FINGERPRINT=

# --- AI (LLM helper) ---
# La config de IA (base_url, model, api_key) se gestiona desde el ADMIN PANEL
# (Servicio "AI" -> Cuentas), donde puedes añadir una o varias API keys.
# No se guarda aquí (ni en el repo) por seguridad.
