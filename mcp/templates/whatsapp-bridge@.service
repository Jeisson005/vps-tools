[Unit]
Description=WhatsApp Baileys bridge (account %i) for MCP gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{WHATSAPP_USER}}
ExecStart=/usr/bin/node {{WHATSAPP_BRIDGE_DIR}}/whatsapp-bridge.js --port {{WHATSAPP_PORT}} --session-dir {{WHATSAPP_SESSIONS_DIR}}/%i
WorkingDirectory={{WHATSAPP_BRIDGE_DIR}}
Environment=NODE_ENV=production
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
