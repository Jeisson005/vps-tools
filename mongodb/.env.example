# MongoDB Configuration
MONGO_INITDB_ROOT_USERNAME=mongoadmin
MONGO_INITDB_ROOT_PASSWORD=changeme
MONGO_INITDB_DATABASE=appdb
MONGO_PORT=27017

# Dirección en la que se publica el puerto. Por defecto 0.0.0.0 (todas las
# interfaces). En un VPS con IP privada conviene fijar la interna, para que la
# base solo sea alcanzable desde la propia red y no dependa del cortafuegos.
# MONGO_BIND_ADDR=10.0.0.2

# Argumentos extra para mongod. Vacío deja los de por defecto de MongoDB.
# En máquinas pequeñas conviene capar la caché de WiredTiger, que si no reserva
# la mitad de (RAM - 1 GB) y compite con el resto de servicios del host.
# MONGO_EXTRA_ARGS=--wiredTigerCacheSizeGB 0.25

# Resource limits (MongoDB)
MONGO_MEM_LIMIT=512m
MONGO_MEM_RESERVATION=256m
MONGO_CPUS=1.0
MONGO_CPUS_RESERVATION=0.2

# Backups
BACKUP_DIR=./backups
RETENTION_DAYS=14
BACKUP_EXCLUDE_DBS=admin,config,local
