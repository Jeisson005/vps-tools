# Copy this file to .env and adjust values
# cp .env.example .env

# On Linux, use your UID/GID to avoid permission issues with bind mounts.
# View them with: id -u  /  id -g
UID=1000
GID=1000

# Certbot / Let's Encrypt
CERTBOT_EMAIL=you@example.com

# NGINX resource tuning (for very low-resource environments)
# CPU in fractional CPUs (compose 'cpus' format) and memory in bytes (eg: 64M)
NGINX_CPUS_LIMIT=0.25
NGINX_MEM_LIMIT=64M
NGINX_CPUS_RESERVE=0.1
NGINX_MEM_RESERVE=32M

# Telegram Notifications for SSL Renewal (Optional)
# TELEGRAM_BOT_TOKEN="123456789:ABCdef..."
# TELEGRAM_CHAT_ID="12345678"
# NOTIFY_ON_SUCCESS=false # Set to true to also receive a message when renewal succeeds
