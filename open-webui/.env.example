# ==============================================================================
# OPEN WEBUI MODULE CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and adjust the variables to your needs.
# NEVER commit your real .env file with actual credentials or secrets to git.

# ── General Settings ──────────────────────────────────────────────────────────
# Custom application name shown in the browser and interface header
WEBUI_NAME="Sofía AI Workspace"

# Secret key used for signing JWT session tokens and encrypting credentials.
# Run 'openssl rand -hex 32' to generate a secure key.
WEBUI_SECRET_KEY=

# Enable or disable user authentication (recommended: true)
WEBUI_AUTH=true

# Allow new users to sign up. 
# TIP: Keep this 'true' for the very first registration (first user becomes Admin),
# then set it to 'false' to prevent unauthorized public registrations.
ENABLE_SIGNUP=true

# ── Network & Ports ───────────────────────────────────────────────────────────
# Port bound locally on 127.0.0.1 behind Nginx reverse proxy
OPEN_WEBUI_PORT=8080

# Public domain where Open WebUI will be served
OPEN_WEBUI_DOMAIN=chat.your-domain.com
USE_SSL=true

# ── Storage & Workspace ───────────────────────────────────────────────────────
# Path for persistent database, users, chat histories, and settings
OPEN_WEBUI_DATA_DIR=./data/open-webui

# Shared workspace folder for uploaded files, scripts, and local execution
OPEN_WEBUI_WORKSPACE_DIR=./data/workspace

# Maximum file upload size in MB (default: 256MB)
MAX_FILE_SIZE_MB=256

# ── Model & Agent Backend Integration ─────────────────────────────────────────
# Default LLM/Agent backend URL (OpenAI-compatible)
# Point to Hermes Proxy on host machine or your preferred LLM provider:
# - Hermes Agent Proxy: http://host.docker.internal:9119/v1
# - LiteLLM / Ollama:   http://host.docker.internal:11434/v1
# - OpenRouter API:     https://openrouter.ai/api/v1
OPENAI_API_BASE_URL=http://host.docker.internal:9119/v1
OPENAI_API_KEY=

# Default model selected when opening new chats
DEFAULT_MODELS=hermes

# ── RAG & Document Processing ─────────────────────────────────────────────────
# Embedding model for document indexing and semantic search
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Web search integration for RAG (optional)
ENABLE_RAG_WEB_SEARCH=false
RAG_WEB_SEARCH_ENGINE=brave
RAG_WEB_SEARCH_API_KEY=
