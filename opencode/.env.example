# OpenCode AI Assistant & Web Service Configuration Template
# Copy to .env and adjust variables with your own values.
# NEVER commit your real .env file with actual credentials to git.

# System user that runs the OpenCode web service
OPENCODE_USER=your_user

# Working directory for OpenCode
OPENCODE_WORKSPACE=/home/your_user

# OpenCode Web Interface Network Settings
OPENCODE_PORT=4096
OPENCODE_HOST=0.0.0.0

# OpenCode Web Basic Authentication Credentials
OPENCODE_SERVER_USERNAME=your_username
OPENCODE_SERVER_PASSWORD=your_secure_password_here

# MCP (Model Context Protocol) Configuration
# Brave Search API Key for web search capabilities (leave blank if not using Brave MCP)
BRAVE_API_KEY=your_brave_search_api_key_here
# Steel Browser API Key for cloud/sandboxed browser automation
STEEL_API_KEY=your_steel_api_key_here

# MCP Gateway / Passbolt Integration
# API key configured in vps-tools/mcp/.env (MCP_API_KEY)
MCP_API_KEY=your_mcp_api_key_here
PASSBOLT_MCP_URL=http://127.0.0.1:8005/passbolt/sse

# Log Level (DEBUG, INFO, WARN, ERROR)
OPENCODE_LOG_LEVEL=INFO
