# Database
POSTGRES_DB=pgdatabase
POSTGRES_USER=pguser
POSTGRES_PASSWORD=changeme

# Postgres runtime options (tweak to your environment)
POSTGRES_SHARED_BUFFERS=48MB
POSTGRES_EFFECTIVE_CACHE_SIZE=96MB
POSTGRES_WORK_MEM=256kB
POSTGRES_MAINTENANCE_WORK_MEM=16MB
POSTGRES_MAX_CONNECTIONS=10
POSTGRES_WAL_BUFFERS=2MB
POSTGRES_MAX_WAL_SIZE=128MB
POSTGRES_CHECKPOINT_TIMEOUT=10min
POSTGRES_AUTOVACUUM_NAPTIME=60s
POSTGRES_AUTOVACUUM_MAX_WORKERS=1
POSTGRES_AUTOVACUUM_VACUUM_SCALE_FACTOR=0.2

# Resource limits (Postgres)
POSTGRES_MEM_LIMIT=200m
POSTGRES_MEM_RESERVATION=180m
POSTGRES_CPUS=0.25
POSTGRES_CPUS_RESERVATION=0.125

# Resource limits (PgBouncer)
PGBOUNCER_MEM_LIMIT=64m
PGBOUNCER_MEM_RESERVATION=48m
PGBOUNCER_CPUS=0.1
PGBOUNCER_CPUS_RESERVATION=0.05
