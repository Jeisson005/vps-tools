# Redis Configuration
REDIS_PORT=6379
REDIS_PASSWORD=changeme

# Redis runtime options
REDIS_MAXMEMORY=128mb
REDIS_MAXMEMORY_POLICY=allkeys-lru
REDIS_SAVE_SNAPSHOTS="60 1 300 10 900 1"
REDIS_APPENDONLY=yes

# Resource limits (Redis)
REDIS_MEM_LIMIT=256m
REDIS_MEM_RESERVATION=128m
REDIS_CPUS=0.5
REDIS_CPUS_RESERVATION=0.1

# Backups
BACKUP_DIR=./backups
RETENTION_DAYS=14
