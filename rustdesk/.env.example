# ==============================================================================
# RustDesk Self-Hosted Server & Host Client Configuration Template
# ==============================================================================
# Server (hbbs/hbbr): rendezvous + relay for your devices.
# Host client (install_host_client.sh): controls this VPS desktop (:1)
# from any RustDesk app pointed at your server.

# Public DNS domain pointing to your VPS (ID + relay over raw TCP)
RUSTDESK_DOMAIN=rustdesk.jeisson.top

# Server Encryption Key (auto-generated by hbbs in data/id_ed25519.pub if left blank)
RUSTDESK_KEY=

# --- Host client (controlled side, captures desktop DISPLAY=:1) ---
# .deb version to install (amd64). Override if you need another release.
RUSTDESK_VERSION=1.4.9
# Local system user owning the desktop session
RUSTDESK_HOST_USER=jeisson
# Permanent password for incoming RustDesk connections.
# Empty = auto-generated once and stored back into .env (chmod 600).
RUSTDESK_HOST_PASSWORD=
# Signaling stays local (no hairpin dependency); relay uses the public domain.
RUSTDESK_RENDEZVOUS=127.0.0.1:21116

# Docker Network
NGINX_NETWORK=nginx_default
