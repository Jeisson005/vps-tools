# ==============================================================================
# RustDesk Self-Hosted Server & Web Client Configuration Template
# ==============================================================================

# Public DNS domains pointing to your VPS
RUSTDESK_DOMAIN=rustdesk.jeisson.top
RUSTDESK_WEB_DOMAIN=desk.jeisson.top

# Server Encryption Key (auto-generated by hbbs in data/id_ed25519.pub if left blank)
RUSTDESK_KEY=

# Web Client Authentication (Web GUI login credentials)
RUSTDESK_WEB_USER=jeisson
RUSTDESK_WEB_PASSWORD=ChangeThisSecurePassword123!

# Timezone & Permissions
TZ=America/Bogota
PUID=1000
PGID=1000

# Docker Network
NGINX_NETWORK=nginx_default
