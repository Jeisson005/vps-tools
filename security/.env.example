# Security - optional local overrides
# Copy to .env (gitignored). NEVER commit the real .env.

# Model for the audit agent. MUST stay the same model as the MCP 'principal'
# AI account (currently deepseek-v4-flash via OpenCode Zen).
AUDIT_MODEL=opencode-go/deepseek-v4-flash

# Max agent runtime in minutes (default: 30)
AGENT_TIMEOUT_MIN=30

# Gitleaks version used by scripts/install.sh
GITLEAKS_VER=8.28.0

# Threshold overrides for the programmatic layer (same names as cron/.env)
# ALERT_COOLDOWN_HOURS=6
