# Sentinel Autonomous Self-Healing & Task Orchestration Suite
# Copy to .env and adjust variables with your own values.
# NEVER commit your real .env file with actual credentials to git.

# ------------------------------------------------------------------------------
# TELEGRAM MULTI-BOT ROUTING CONFIGURATION
# ------------------------------------------------------------------------------
# 🔴 Bot 1: Urgent (Critical unhealed errors, broken tasks, human action required)
TELEGRAM_BOT_URGENT_TOKEN=your_bot1_urgent_token_here

# 🟡 Bot 2: Routine (Autofixes info, transient notices, reminders every 12-24h)
TELEGRAM_BOT_ROUTINE_TOKEN=your_bot2_routine_token_here

# 🔵 Bot 3: Hermes Agent Username (Target for 1-click inline action buttons)
# e.g. "sofia005_hermes_bot" (without @)
TELEGRAM_BOT_HERMES_USERNAME=your_hermes_bot_username

# 🟢 Bot 4: Human-in-the-Loop (Live Viewer 2FA/Captcha interactive sessions)
TELEGRAM_BOT_HITL_TOKEN=your_bot4_hitl_token_here

# Target Telegram Chat ID (Shared chat or admin user ID)
TELEGRAM_CHAT_ID=123456789

# ------------------------------------------------------------------------------
# SENTINEL ENGINE & MCP SERVER SETTINGS
# ------------------------------------------------------------------------------
SENTINEL_PORT=8006
SENTINEL_HOST=0.0.0.0
SENTINEL_API_KEY=your_secure_sentinel_api_key_here

# System user that runs Sentinel services
SENTINEL_USER=your_user

# Self-Healing Safeguards & Cooldowns
MAX_REPAIR_ATTEMPTS=2
REMINDER_INTERVAL_HOURS=12
HITL_TIMEOUT_MINUTES=15

# System health monitoring thresholds
DISK_ALERT_THRESHOLD=85
MONITORED_MOUNTS="/"

# OpenCode Binary Location
OPENCODE_BIN=/usr/local/bin/opencode

# ------------------------------------------------------------------------------
# HYBRID CLASSIFIER — TIER 1 AI REFEREE (reutiliza la IA del panel MCP)
# Por defecto ACTIVO si el gateway MCP local (127.0.0.1:8005) tiene cuenta IA
# (tu cuenta 'principal' deepseek ya cuenta). No necesitas duplicar keys.
# Tier 0 regex+exit-codes siempre activo; Tier 1 solo en casos ambiguos.
# Opt-out: SENTINEL_AI_ENABLED=false. Fallback directo solo si MCP cae.
# ------------------------------------------------------------------------------
SENTINEL_AI_ENABLED=
SENTINEL_AI_BASE_URL=https://api.openai.com/v1
SENTINEL_AI_API_KEY=
SENTINEL_AI_MODEL=gpt-4o-mini
SENTINEL_AI_TIMEOUT=20
SENTINEL_AI_MAX_TOKENS=300
