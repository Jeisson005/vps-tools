# ==============================================================================
# VPS INITIAL SETUP CONFIGURATION
# ==============================================================================

# User configuration
NEW_USER=deploy
# Password for the new user (leave blank to be prompted interactively or set here)
NEW_USER_PASSWORD=""
# Public SSH Key string for the new user (leave empty to copy current user/root key or prompt)
NEW_USER_SSH_KEY=""
# Allow passwordless sudo for the user (yes/no)
PASSWORDLESS_SUDO=yes

# SSH Hardening
SSH_PORT=22
DISABLE_ROOT_SSH=yes
DISABLE_PASSWORD_AUTH=yes

# Firewall (UFW)
ENABLE_UFW=yes
# Additional ports to open (space-separated, e.g. "80 443")
UFW_EXTRA_PORTS="80 443"

# Fail2ban
FAIL2BAN_BANTIME=1h
FAIL2BAN_FINDTIME=10m
FAIL2BAN_MAXRETRY=5

# System & Tuning
TIMEZONE=UTC
# Swap file size (e.g. 2G, 4G). Set to 0 to disable swap creation
SWAP_SIZE=4G
SWAPPINESS=10

# System Journal Max Size
JOURNAL_MAX_USE=500M

# MOTD Banner Customization (Artic style from jeisson-server3)
CUSTOM_MOTD_BANNER=yes
MOTD_AUTHOR="Jeisson"
MOTD_WELCOME_MSG="Welcome to Artic Jeisson server!"
MOTD_SHOW_METRICS=yes

# Network Optimization (Google BBR)
ENABLE_BBR=yes

# Docker Engine & Docker Compose
INSTALL_DOCKER=yes
# Auto-configure /etc/docker/daemon.json with global log rotation and live-restore
DOCKER_DEFAULT_LOG_ROTATION=yes
