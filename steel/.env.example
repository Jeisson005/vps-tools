# Steel Browser Sandbox Configuration Template
# Copy to .env and adjust variables with your own values.
# NEVER commit your real .env file with actual credentials to git.

# Steel API Secret Key (required for authenticating API, Live sessions, and CDP requests)
STEEL_API_KEY=your_secure_steel_api_key_here

# Ports (bound to 127.0.0.1 for security behind reverse proxy)
STEEL_PORT=3000
STEEL_CDP_PORT=9223

# Performance & Concurrency Settings
STEEL_LOG_LEVEL=info
STEEL_TIMEOUT_MS=300000
STEEL_CONCURRENCY=10
