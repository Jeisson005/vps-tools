# Steel Browser Sandbox Configuration Template
# Copy to .env and adjust variables with your own values.
# NEVER commit your real .env file with actual credentials to git.

# Steel API Secret Key (required for the REST API, Live sessions and CDP routing)
STEEL_API_KEY=your_secure_steel_api_key_here

# Public Domain & SSL for Live Viewer WebSocket connections
USE_SSL=true
STEEL_DOMAIN=browser.your-domain.com

# Local API port (loopback only, behind the Nginx reverse proxy)
STEEL_PORT=3000
STEEL_LOG_LEVEL=info

# --- Concurrency model ------------------------------------------------------
# Self-hosted Steel (v0.5.x) runs ONE session per instance by design.
# The router does NOT scale or stop containers: it only assigns each new
# session to a free instance (0 active sessions) and routes traffic to it.

# Session cleanup: release live/idle sessions older than this (seconds).
# Steel does NOT enforce session expiry itself, so this drives cleanup_sessions.sh.
STEEL_SESSION_MAX_AGE_SEC=86400

# --- Worker recycling (recycle_workers.sh) ----------------------------------
# Restart a worker WITHOUT active sessions once it accumulates more than N zombies.
STEEL_RECYCLE_ZOMBIE_THRESHOLD=20

# worker:local-API-port map used by the cleanup/recycle scripts.
STEEL_WORKERS="steel-browser-1:3001 steel-browser-2:3002 steel-browser-3:3003"

# At the end of the nightly cleanup, recycle (restart) empty workers to clear
# SingletonLock and zombies. Opt-out: STEEL_RECYCLE_EMPTY=false
STEEL_RECYCLE_EMPTY=true

# --- Session lifecycle (router) ---------------------------------------------
# Sessions WITHOUT a lease are released after N seconds without HTTP/CDP activity.
SESSION_IDLE_RELEASE_SEC=1800
# Default rolling TTL for leased sessions when the client does not specify one.
SESSION_LEASE_DEFAULT_TTL_SEC=300
# Grace after a lease expires before releasing (network hiccup protection).
SESSION_HEARTBEAT_GRACE_SEC=120
# Reaper interval.
SESSION_REAPER_INTERVAL_SEC=30
# Hard session lifetime cap (0 = disabled).
SESSION_MAX_AGE_SEC=0

# --- MCP wrapper (steel-mcp) ------------------------------------------------
# Lease TTL renewed on every heartbeat.
STEEL_LEASE_TTL_SEC=300
# Activity window: after this idle time the wrapper stops heartbeating and the
# router releases the session.
STEEL_ACTIVE_WINDOW_SEC=1800
# Heartbeat interval while there is activity.
STEEL_HEARTBEAT_INTERVAL_SEC=60
# Persistent context sync interval to disk (persistent mode).
STEEL_CONTEXT_SYNC_SEC=300
