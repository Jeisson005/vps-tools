server {
  listen 80;
  server_name ${STEEL_DOMAIN};

  location ^~ /.well-known/acme-challenge/ {
    root /var/www/certbot;
    default_type "text/plain";
    try_files $uri =404;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${STEEL_DOMAIN};

  access_log /dev/stdout;
  access_log /var/log/nginx/${STEEL_DOMAIN}.access.log;
  error_log  /dev/stderr warn;

  ssl_certificate     /etc/letsencrypt/live/${STEEL_DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${STEEL_DOMAIN}/privkey.pem;

  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;

  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Strict-Transport-Security "max-age=15552000" always;

  # By default, allow direct access to live viewer / API / WebSockets with session IDs
  auth_basic off;

  # Protect the public UI dashboard and root listing
  location = / {
    auth_basic "Steel Dashboard Protected";
    auth_basic_user_file /etc/nginx/auth/.htpasswd;
    proxy_pass http://host.docker.internal:${STEEL_PORT:-3000};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 86400s;
    proxy_send_timeout 86400s;
    proxy_buffering off;
  }

  location ^~ /ui {
    auth_basic "Steel Dashboard Protected";
    auth_basic_user_file /etc/nginx/auth/.htpasswd;
    proxy_pass http://host.docker.internal:${STEEL_PORT:-3000};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 86400s;
    proxy_send_timeout 86400s;
    proxy_buffering off;
  }

  # All other routes (Live Viewer /v1/sessions/debug, devtools, WebSockets) open cleanly with session ID
  location / {
    proxy_pass http://host.docker.internal:${STEEL_PORT:-3000};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 86400s;
    proxy_send_timeout 86400s;
    proxy_buffering off;
  }
}
