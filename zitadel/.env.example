# Example project-level environment variables for docker-compose
# Copy to .env and replace with real values. Do NOT commit .env to version control.

# Master key must be 32 characters
MASTERKEY=MasterkeyNeedsToHave32Characters

# UID and GID used to run containers to avoid permission issues
UID=1000
GID=1000

# Core (zitadel core) resource defaults (tune as needed)
CORE_LIMIT_CPUS=0.2
CORE_LIMIT_MEMORY=256M
CORE_RESERVATION_CPUS=0.1
CORE_RESERVATION_MEMORY=128M

# Login (frontend) resource defaults
LOGIN_LIMIT_CPUS=0.2
LOGIN_LIMIT_MEMORY=200M
LOGIN_RESERVATION_CPUS=0.1
LOGIN_RESERVATION_MEMORY=64M
