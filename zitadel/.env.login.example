# If you can't use the network_mode service:core, you can pass the environment variables ZITADEL_API_URL=http://core:8080 and CUSTOM_REQUEST_HEADERS=Host:localhost instead.
ZITADEL_API_URL=http://localhost:8080
# IMPORTANT: ZITADEL selects the instance by the request Host header.
# Set this to match your ExternalDomain (e.g. Host:auth.example.com).
# Without this, the login UI might fail to find the correct instance.
# CUSTOM_REQUEST_HEADERS=Host:localhost
NEXT_PUBLIC_BASE_PATH=/ui/v2/login
ZITADEL_SERVICE_USER_TOKEN_FILE=/current-dir/login-client.pat
